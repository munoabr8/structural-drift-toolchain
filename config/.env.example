# ======================================================
# Core / Runtime (usually inherited, rarely overridden)
# ======================================================
# PATH=/usr/local/bin:/usr/bin:/bin
# HOME=/home/user
# SHELL=/bin/bash
# Leave commented unless you know what you're doing.

# ======================================================
# Repository Context
# ======================================================
REPO=owner/repo
MAIN_BRANCH=main
# Path to NDJSON events file (usually artifacts/events.ndjson)
EVENTS=artifacts/events.ndjson
# Environment target (production, staging, dev)
DEPLOY_ENV=production

# ======================================================
# Auth / API Tokens
# ======================================================
# Required for fetching artifacts and interacting with GitHub API
GH_TOKEN=ghp_yourTokenHere

# ======================================================
# Metrics Parameters
# ======================================================
WINDOW_DAYS=14
PCTL=90
MIN_LEAD_SAMPLES=1
LT_MIN_LEAD_SECONDS=300
# Options: change | deployment | both
LT_PAIR_MODE=change

# ======================================================
# Logging / Observability
# ======================================================
# Wrap stdout/stderr in logs (0=off, 1=on)
LOG_INLINE=0
# Maximum captured head of stdout/stderr
LOG_WRAP_HEAD=4096
# Fail hard on warnings (0=warn only, 1=exit)
STRICT=0
# Provenance: host | env | vm
CONTEXT=host

# ======================================================
# Output / Reporting
# ======================================================
# Opt-in CSV output
LEADTIME_CSV=leadtime.csv
# Artifact directory
ART_DIR=artifacts
# Explicit output file (if required by a target)
OUT=
