# config/ci.env

[ -n "${CI:-}" ] || return 0
: "${GITHUB_WORKSPACE:=$PWD}"   # fallback for local probes


# Token injected by GitHub Actions
GH_TOKEN=${GITHUB_TOKEN:-}

# Force CI mode flags
STRICT=1
CI=true

# Paths inside CI workspace
ARTIFACTS_DIR=$GITHUB_WORKSPACE/artifacts
LOG_DIR=$GITHUB_WORKSPACE/artifacts/logs
