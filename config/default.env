# config/default.env
MAIN_BRANCH=main
WINDOW_DAYS=14
PCTL=90
LT_MIN_LEAD_SECONDS=300
STRICT=0


# keep the old name as an alias for backward compatibility

ARTIFACTS_DIR="${ARTIFACTS_DIR:-${ART_DIR:-artifacts}}"

# Default repo fallback if GITHUB_REPOSITORY is missing
REPO="${REPO:-${GITHUB_REPOSITORY:-}}"

COMPLEXITY_ENABLE=0
COMPLEXITY_LEVEL=basic