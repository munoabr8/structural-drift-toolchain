# config/default.env
MAIN_BRANCH=main
WINDOW_DAYS=14
PCTL=90
LT_MIN_LEAD_SECONDS=300
STRICT=0


#local.env already has this key value.
#Should this be removed to avoid duplication?
# OR should this key=value remain here and 
# local.env artifacts key value be removed?
ARTIFACTS_DIR=artifacts
ENV_ARTDIR=artifacts/env

EVENTS=artifacts/events.ndjson


# Default repo fallback if GITHUB_REPOSITORY is missing
REPO=munoabr8/structural-drift-toolchain

: "${ENV:=production}"   # or dev



