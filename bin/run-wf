#!/usr/bin/env bash
# bin/run-wf — robust runner with per-run manifest
set -euo pipefail

# --- init ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
: "${ROOT:?root missing}"

command -v jq >/dev/null || { echo "ERR: need jq" >&2; exit 69; }
command -v make >/dev/null || { echo "ERR: need make" >&2; exit 69; }
command -v git >/dev/null || true

# contracts (optional)
CONTRACT_DIR="${CONTRACT_DIR:-$ROOT/ci/contract}"
NORMALIZER="${NORMALIZER:-$CONTRACT_DIR/jq/normalize_v1.jq}"
contract_path(){ local wf="$1" base; base="$(printf '%s\n' "$wf" | sed 's|^wf/||; s|/|-|g')"; printf '%s/%s.contract.json' "$CONTRACT_DIR" "$base"; }
show_contract(){ local wf="$1" cf; cf="$(contract_path "$wf")"; test -s "$cf" && test -s "$NORMALIZER" || { echo "ERR: contract/normalizer missing" >&2; exit 64; }; jq -f "$NORMALIZER" "$cf"; }
check_contract(){ local wf="$1"; show_contract "$wf" >/tmp/contract.norm.$$; jq -e '.schema=="ir/v1" and (.args|type=="array") and (.env|type=="object") and (.exit.ok==0)' /tmp/contract.norm.$$ >/dev/null; }
usage(){ echo "usage: $(basename "$0") [--contract WF|--check-contract WF] [-f MAKEFILE] WF [-- VARS...]"; exit 64; }

case "${1:-}" in
  --contract) shift; wf="${1:-}"; [ -n "$wf" ] || usage; show_contract "$wf"; exit 0;;
  --check-contract) shift; wf_chk="${1:-}"; [ -n "$wf_chk" ] || usage; check_contract "$wf_chk" || { echo "contract invalid" >&2; exit 64; }; shift;;
esac

MAKEFILE_DEFAULT="system/make/env.mk"
MAKEFILE="${MAKEFILE_DEFAULT}"
LOGS_DIR_DEFAULT="$ROOT/artifacts/logs"
LOG_FILE="${LOG_FILE:-}"

# flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--makefile) MAKEFILE="$2"; shift 2;;
    -l|--log) LOG_FILE="$2"; shift 2;;
    --logs-dir) LOGS_DIR_DEFAULT="$2"; shift 2;;
    --) shift; break;;
    -*) usage;;
    *) break;;
  esac
done

target="${1:-}"; [[ -n "${target:-}" ]] || usage; shift || true

# names + paths
. "$ROOT/system/names.sh"   # safe_name()
RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
START_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

MANIFEST_DIR="$ROOT/artifacts/runs"; mkdir -p "$MANIFEST_DIR"
MANIFEST="$MANIFEST_DIR/$RUN_TS.json"
MANIFEST_TMP="$MANIFEST_DIR/$RUN_TS.json.tmp"; rm -f "$MANIFEST_TMP"

STD_DIR="${STD_DIR:-$ROOT/artifacts/stdout}"
ERR_DIR="${ERR_DIR:-$ROOT/artifacts/stderr}"
mkdir -p "$STD_DIR" "$ERR_DIR"
BASE="$(safe_name "$target")"
STDOUT_PATH="$STD_DIR/${BASE}.out"
STDERR_PATH="$ERR_DIR/${BASE}.err"

if [[ -z "${LOG_FILE}" ]]; then mkdir -p "$LOGS_DIR_DEFAULT"; LOG_FILE="$LOGS_DIR_DEFAULT/run.$RUN_TS.ndjson"; fi
echo "run-wf: target=$target makefile=${MAKEFILE#$ROOT/} log=${LOG_FILE#$ROOT/}" >&2

code=111
END_TS=""

write_manifest() {
  local exit_code="${1:-$code}"
  END_TS="${END_TS:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  local SHA BRANCH DIRTY
  SHA="$(git rev-parse --verify HEAD 2>/dev/null || echo "")"
  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  DIRTY="$(test -n "$(git status --porcelain 2>/dev/null || true)" && echo true || echo false)"
  local ISOLATE_MODE="${ISOLATE:-env}" ALLOW_LIST="${ALLOW:-}"
  jq -n \
    --arg schema "runs/v1" \
    --arg target "$target" \
    --arg makefile "${MAKEFILE#$ROOT/}" \
    --arg start "$START_TS" \
    --arg end "$END_TS" \
    --argjson exit "$exit_code" \
    --arg sha "$SHA" \
    --arg branch "$BRANCH" \
    --argjson dirty "$DIRTY" \
    --arg mode "$ISOLATE_MODE" \
    --arg allow "$ALLOW_LIST" \
    --arg log "${LOG_FILE#$ROOT/}" \
    --arg stdout "${STDOUT_PATH#$ROOT/}" \
    --arg stderr "${STDERR_PATH#$ROOT/}" \
    '{
      schema:$schema,
      target:$target,
      makefile:$makefile,
      start_ts:$start,
      end_ts:$end,
      exit:$exit,
      repo:{sha:$sha,branch:$branch,dirty:$dirty},
      isolation:{mode:$mode,allow:( if ($allow|length)==0 then [] else ($allow|gsub("[,[:space:]]+";" ")|split(" ")|map(select(.!=""))) end )},
      log_file:$log,
      artifacts:{stdout_path:$stdout,stderr_path:$stderr}
    }' >"$MANIFEST.tmp" && mv -f "$MANIFEST.tmp" "$MANIFEST" || { rm -f "$MANIFEST_TMP"; return 1; }
}

trap 'rm -f "$MANIFEST_TMP"; write_manifest "$code"' EXIT

# --- delegate invocation ---

# remove any forwarded -f/--makefile so we control MK path
forward_args=(); skip=0
for a in "$@"; do
  if (( skip )); then skip=0; continue; fi
  case "$a" in -f|--makefile) skip=1 ;; *) forward_args+=("$a") ;; esac
done

DELEGATE="$ROOT/system/exec_isolated.sh"
[[ -x "$DELEGATE" ]] || { echo "missing $DELEGATE" >&2; exit 64; }

: "${MODE:=local}"         # local|vm
: "${VM:=iso}"
: "${ALLOW:=PATH HOME}"
: "${TIMEOUT:=}"

DELEGATE_ARGS=(
  --mode "$MODE"
  --repo "$ROOT"
  --makefile "$ROOT/$MAKEFILE"
  --target "$target"
  --vm-name "$VM"
  --allow "$ALLOW"
  --timeout "$TIMEOUT"
  --stdout "$STDOUT_PATH"
  --stderr "$STDERR_PATH"
  --logs "$LOG_FILE"
)

if "$DELEGATE" "${DELEGATE_ARGS[@]}" -- "${forward_args[@]}"; then
  code=0
else
  code=$?
fi

END_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
exit "$code"
