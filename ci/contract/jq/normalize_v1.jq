{
  schema: "ir/v1",
  name: (.name // "unknown"),
  version: (.version // ""),
  args: (.args // []),
  env: (.env // {}),
  derived: (.derived // {}),
  reads: (.reads // ""),
  writes: (.writes // []),
  tools: (.tools // []),
  exit: (.exit // {}),
  outputs: (.outputs // {}),
  idempotent: (.idempotent // false),
  notes: (.notes // "")
}
